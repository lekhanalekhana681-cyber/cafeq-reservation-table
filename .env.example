# ==============================================================================
# CafeQ Environment Configuration Template
# ==============================================================================

# Supabase Configuration (Optional - falls back to persistent storage if omitted)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ==============================================================================
# ⚠️ SECURITY NOTICE: ADMINISTRATOR DEFAULT CREDENTIALS
# The default admin credentials below (CafeQ / Cafe@123) are for local development ONLY.
# You MUST change ADMIN_PASSWORD to a strong, secure passphrase before deploying to production!
# ==============================================================================
ADMIN_USERNAME=CafeQ
ADMIN_PASSWORD=Cafe@123
ADMIN_EMAIL=admin@cafeq.com
ADMIN_NAME=CafeQ Master Admin
ADMIN_PHONE=+91 90000 00001

VITE_ADMIN_USERNAME=CafeQ
VITE_ADMIN_PASSWORD=Cafe@123
VITE_ADMIN_EMAIL=admin@cafeq.com
VITE_ADMIN_NAME=CafeQ Master Admin
VITE_ADMIN_PHONE=+91 90000 00001

# ==============================================================================
# ⚠️ SECURITY NOTICE: KITCHEN STAFF DEFAULT CREDENTIALS
# The default kitchen credentials below (Kitchen / Kitchen@123) are for local development ONLY.
# You MUST change KITCHEN_PASSWORD before deploying to production!
# ==============================================================================
KITCHEN_USERNAME=Kitchen
KITCHEN_PASSWORD=Kitchen@123
KITCHEN_EMAIL=kitchen@cafeq.com
KITCHEN_NAME=CafeQ Kitchen Staff
KITCHEN_PHONE=+91 90000 00002

VITE_KITCHEN_USERNAME=Kitchen
VITE_KITCHEN_PASSWORD=Kitchen@123
VITE_KITCHEN_EMAIL=kitchen@cafeq.com
VITE_KITCHEN_NAME=CafeQ Kitchen Staff
VITE_KITCHEN_PHONE=+91 90000 00002

# ==============================================================================
# Online Payment Gateway (Razorpay) — pre-order deposits / prepayment
# ==============================================================================
# SERVER-ONLY values: used by the Vercel functions in /api. Never prefix them with
# VITE_ (anything starting with VITE_ is bundled into the browser).
# Start with TEST mode keys (rzp_test_...) from Razorpay Dashboard › Account & Settings › API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard › Webhooks › secret you choose for https://<your-domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Service-role key (Supabase › Project Settings › API) — lets /api update payments. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: signs admin payment sessions (defaults to the service-role key)
PAYMENTS_ADMIN_SECRET=
# Optional: protects /api/cron/expire-unpaid when called by Vercel Cron or another scheduler
CRON_SECRET=

# Legacy client-side Razorpay demo (non-pre-order "Pay with Razorpay" option only)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# ==============================================================================
# Multi-Channel Notifications (SMS, Email, WhatsApp)
# ==============================================================================
# SMS Provider Selection: "msg91" | "twilio" (defaults to simulator if keys empty)
VITE_SMS_PROVIDER=msg91

# MSG91 Credentials
VITE_MSG91_AUTH_KEY=
VITE_MSG91_SENDER_ID=CAFEQ
VITE_MSG91_TEMPLATE_ID=

# Twilio SMS Credentials
VITE_TWILIO_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_FROM_PHONE=

# SMTP / Transactional Email Credentials
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=
VITE_SMTP_PASS=
VITE_SMTP_FROM_EMAIL=reservations@cafeq.com

# WhatsApp Business Cloud API Credentials
VITE_WHATSAPP_API_KEY=
VITE_WHATSAPP_PHONE_NUMBER_ID=
